# KKM complaint scraper configuration.
# Copy to .env and fill in the values.
# IMPORTANT: put comments on their own line, never after a value on the same line.

# --- Apps Script backend (required) ---
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_API_TOKEN=

# --- Reviewer (required for real verdicts; without a key the run falls back to regex rules) ---
# anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (cheapest) | claude-sonnet-5 | claude-opus-5
ANTHROPIC_MODEL=claude-haiku-4-5
# 1 = send the screenshot to the reviewer so on-image claims are read. Leave at 1.
LLM_USE_SCREENSHOT=1
# Server-side refusal fallback. 1 = on.
ANTHROPIC_FALLBACKS=1

# Only used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Screenshots ---
# apps_script (default, no extra credentials) | drive_api | none
SCREENSHOT_MODE=apps_script
# drive_api only
GDRIVE_SA_JSON=
GDRIVE_FOLDER_ID=

# --- Browser session (optional) ---
# Leave BOTH of these blank on Windows: drop storage_state.json beside main.py
# and it is found automatically.
# Base64 of storage_state.json, used by GitHub Actions.
PW_STORAGE_STATE_B64=
# An explicit path, only if the file is somewhere else.
PW_STORAGE_STATE_PATH=
# Path to a system Chromium binary. Leave blank to use the one Playwright installed.
PW_CHROMIUM_PATH=
