# --- Apps Script backend ---
APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_API_TOKEN=paste_API_TOKEN_from_Script_Properties

# --- LLM reviewer (one provider) ---
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FALLBACKS=1             # server-side refusal fallback (beta); set 0 to disable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
LLM_USE_SCREENSHOT=1              # send the screenshot to the reviewer (on-image claims count)

# --- Screenshots ---
SCREENSHOT_MODE=apps_script       # apps_script (default, no extra creds) | drive_api | none
GDRIVE_SA_JSON=                   # drive_api only: service-account JSON (raw or base64)
GDRIVE_FOLDER_ID=                 # drive_api only: folder shared with the service account

# --- Playwright ---
PW_STORAGE_STATE_B64=             # optional: base64 of storage_state.json from a logged-in browser
PW_STORAGE_STATE_PATH=            # optional: path alternative to the above
PW_CHROMIUM_PATH=                 # optional: path to a system Chromium binary
